import math

def cosd(angle):
    return math.cos(math.radians(angle))

def sind(angle):
    return math.sin(math.radians(angle))

def atand(value):
    return math.degrees(math.atan(value))

def main():
    TODEN = 10000
    G = 32.2  # Gravedad en ft/s^2

  print("INPUT IOPT (1 for full calculation, 2 for simplified):")
    IOPT = int(input())

    #INPUT ALT (altitude in ft), RHO (density in slugs/ft^3), VS (steady-state velocity in ft/s), CDSO (drag area in ft^2), TO (inflation time in s), W (weight in lbs), J (inflation profile exponent), TAU (time constant), ALPHA0 (initial angle in degrees):
