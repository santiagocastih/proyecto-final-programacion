    #10000 0.001527032 170.439638 7.1149379 0.343 86.18637518 3 0 0  ---- Drogue Nominal (SRAD)
    #10000 0.001527032 170.439638 7.1149379 0.2007 86.18637518 3 0 0 ---- Drogue Nominal (COTS)
    #10000 0.001527032 233.431766 10.7639 0.251 86.18637518 3 0 0  ---- Drogue OFF-Nominal (COTS)
    #10000 0.001527032 233.431766 10.7639 0.151 86.18637518 3 0 0 ---- Drogue OFF-Nominal (SRAD)

    #1476.38 0.001986888 89.1076144 181.0810897 1.533 86.18637518 6 0 0    ---- Main Nominal(COTS)
    #1476.38 0.001986888 89.1076144 442.6438597 2.398 86.18637518 6 0 0    ---- Main Nominal(SRAD)
    #1476.38 0.001527032 196.8504 442.6438597 0.694 86.18637518 6 0 0    ---- Main OFF-Nominal(COTS)
    #1476.38 0.001527032 196.8504 181.0810897 1.085 86.18637518 6 0 0    ---- Main OFF-Nominal(SRAD)

    #10000 0.001527032 82.546 8.697 0.228 81.218 3 0 0  ---- Drogue Nominal (Design)
